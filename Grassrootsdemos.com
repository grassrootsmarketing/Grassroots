<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grassroots Marketing — In-Store Demo & Brand Ambassador Programs</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,700&family=Lora:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
<style>
:root {
  --green-dark:#1A5C2E;--green:#2E8B4A;--green-mid:#4CAF6F;--green-light:#7DD99A;
  --green-pale:#E8F7ED;--green-xpale:#F2FBF5;
  --terra:#D4613C;--terra-pale:#FAEEE8;
  --yellow:#F5C842;--yellow-pale:#FFFBE6;
  --cream:#FEFDF8;--warm:#F7F3E8;
  --charcoal:#1E2B22;--mid:#4A5E52;--muted:#89A094;
  --border:rgba(46,139,74,0.15);
  --serif:'Lora',Georgia,serif;--sans:'Nunito',system-ui,sans-serif;
  --radius:16px;--radius-sm:10px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--cream);color:var(--charcoal);font-size:18px;line-height:1.75;overflow-x:hidden}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 48px;height:104px;background:rgba(254,253,248,0.95);backdrop-filter:blur(14px);border-bottom:1px solid var(--border)}
.nav-logo img{height:72px;width:auto;display:block}
.nav-links{display:flex;gap:32px;list-style:none;align-items:center}
.nav-links a{font-size:15px;font-weight:600;color:var(--mid);text-decoration:none;transition:color 0.2s}
.nav-links a:hover{color:var(--green)}
.nav-cta{background:var(--green)!important;color:#fff!important;padding:10px 22px;border-radius:50px;font-weight:700!important;transition:background 0.2s!important}
.nav-cta:hover{background:var(--green-mid)!important}

/* HERO */
.hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:136px 56px 80px;gap:64px;background:var(--green-xpale);position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-120px;right:-120px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(125,217,154,0.25) 0%,transparent 70%);pointer-events:none}
.hero::after{display:none}
.hero h1{font-family:var(--serif);font-size:clamp(46px,5vw,72px);font-weight:600;line-height:1.15;letter-spacing:-0.5px;color:var(--charcoal);margin-bottom:24px}
.hero h1 em{font-style:italic;color:var(--green)}
.hero-desc{font-size:19px;line-height:1.7;color:var(--mid);max-width:500px;margin-bottom:40px}
.hero-actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.btn-primary{display:inline-flex;align-items:center;gap:8px;background:var(--green);color:#fff;padding:15px 32px;border-radius:50px;font-weight:700;font-size:15px;text-decoration:none;transition:background 0.2s,transform 0.15s;font-family:var(--sans)}
.btn-primary:hover{background:var(--green-mid);transform:translateY(-2px)}
.btn-secondary{display:inline-flex;align-items:center;gap:6px;color:var(--green);font-size:15px;font-weight:700;text-decoration:none}
.btn-secondary::after{content:'→'}
.btn-secondary:hover{gap:10px}
.hero-stats{display:flex;gap:36px;margin-top:48px;padding-top:36px;border-top:1px solid var(--border);flex-wrap:wrap}
.stat-num{font-family:var(--serif);font-size:34px;font-weight:600;color:var(--charcoal);line-height:1}
.stat-label{font-size:13px;color:var(--muted);margin-top:4px;font-weight:600}
.hero-visual{position:relative;display:flex;justify-content:center}
.hero-photo-card{width:100%;max-width:560px;border-radius:24px;overflow:hidden;box-shadow:0 24px 64px rgba(30,43,34,0.18)}
.hero-photo-card img{width:100%;height:680px;object-fit:cover;object-position:center top;display:block}

/* RETAILERS */
.retailers-band{background:var(--terra);padding:36px 48px;display:flex;align-items:center;justify-content:center;gap:64px;flex-wrap:wrap}
.retailers-band-label{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.5);font-weight:700}
.retailer-pill{font-family:var(--serif);font-size:18px;font-style:italic;color:rgba(255,255,255,0.9);font-weight:600}

/* LOGO STRIP */
.logo-strip{background:var(--warm);padding:48px 0;overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.logo-strip-label{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:28px;font-weight:700}
.logo-track{overflow:hidden}
.logo-inner{display:flex;align-items:center;gap:56px;width:max-content;animation:logoScroll 32s linear infinite}
.logo-track:hover .logo-inner{animation-play-state:paused}
@keyframes logoScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.logo-item{flex-shrink:0;width:140px;height:80px;opacity:0.6;transition:opacity 0.2s,filter 0.2s;filter:grayscale(0.15);display:flex;align-items:center;justify-content:center}
.logo-item:hover{opacity:1;filter:none}
.logo-item img{width:120px;height:64px;object-fit:contain;object-position:center}

/* SECTION BASE */
section{padding:96px 56px}
.section-label{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--green);background:var(--green-pale);padding:5px 14px;border-radius:50px;margin-bottom:16px}
.section-title{font-family:var(--serif);font-size:clamp(34px,4vw,56px);font-weight:600;line-height:1.2;letter-spacing:-0.3px;color:var(--charcoal);margin-bottom:18px}
.section-title em{font-style:italic;color:var(--green)}
.section-body{font-size:19px;color:var(--mid);line-height:1.7;font-weight:400;max-width:540px}

/* HOW IT WORKS */
.how-it-works{background:var(--warm)}
.how-inner{max-width:1100px;margin:0 auto}
.how-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:56px;gap:40px}
.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.step{background:var(--cream);padding:32px 28px;border-radius:var(--radius);border:1.5px solid var(--border);transition:transform 0.2s,box-shadow 0.2s,border-color 0.2s}
.step:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(212,97,60,0.12);border-color:var(--terra)}
.step-icon{width:44px;height:44px;border-radius:var(--radius-sm);background:var(--terra-pale);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px}
.step-title{font-weight:800;font-size:15px;color:var(--charcoal);margin-bottom:8px}
.step-desc{font-size:16px;color:var(--muted);line-height:1.6;font-weight:600}

/* SERVICES */
.services{background:var(--cream)}
.services-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:360px 1fr;gap:96px;align-items:start}
.services-left{position:sticky;top:120px}
.service-item{padding:32px 0;border-bottom:1.5px solid var(--border)}
.service-item:first-child{border-top:1.5px solid var(--border)}
.service-icon{width:48px;height:48px;border-radius:var(--radius-sm);background:var(--terra-pale);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:14px}
.service-name{font-weight:800;font-size:18px;color:var(--charcoal);margin-bottom:8px}
.service-desc{font-size:17px;color:var(--mid);line-height:1.65}
.service-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.tag{font-size:13px;color:var(--terra);background:var(--terra-pale);padding:4px 14px;border-radius:50px;font-weight:700}

/* GALLERY */
.gallery-section{background:var(--terra-pale);padding:96px 0 0}
.gallery-inner{max-width:100%;margin:0;padding:0 56px 48px}
.gallery-inner .section-title{margin-bottom:32px}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(5,320px);gap:4px}
.gallery-item{position:relative;overflow:hidden;cursor:pointer;transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.4s}
.gallery-item:hover{transform:scale(1.04);box-shadow:0 20px 56px rgba(30,43,34,0.35),0 0 0 3px var(--green-light);z-index:3}
.gallery-item img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform 0.55s cubic-bezier(0.25,0.46,0.45,0.94)}
.gallery-item:hover img{transform:scale(1.04)}
.gallery-overlay{position:absolute;bottom:0;left:0;right:0;padding:32px 16px 14px;background:linear-gradient(to top,rgba(20,36,24,0.9) 0%,rgba(20,36,24,0.2) 55%,transparent 100%);opacity:0.6;transition:opacity 0.3s}
.gallery-item:hover .gallery-overlay{opacity:1}
.gallery-overlay span{font-size:11px;font-weight:800;color:rgba(255,255,255,0.92);letter-spacing:0.08em;text-transform:uppercase}

/* REACH */
.reach{background:var(--warm)}
.reach-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.states-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.state-pill{background:var(--cream);border:1.5px solid var(--border);border-radius:8px;padding:8px 4px;text-align:center;font-size:12px;font-weight:700;color:var(--muted)}
.state-pill.active{background:var(--green);color:#fff;border-color:var(--green)}
.state-pill.coming{background:var(--terra-pale);color:var(--terra);border-color:rgba(212,97,60,0.25);font-size:9px;letter-spacing:0.03em;position:relative}
.state-pill.coming::after{content:'soon';display:block;font-size:8px;font-weight:700;opacity:0.7;line-height:1}

/* TESTIMONIALS */
.testimonials{background:var(--charcoal);padding:96px 56px}
.testimonials-inner{max-width:1100px;margin:0 auto}
.testimonials .section-title{color:#fff}
.testimonials .section-title em{color:var(--green-light)}
.testimonials .section-label{background:rgba(125,217,154,0.15);color:var(--green-light)}
.testimonials-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}
.tcard{background:rgba(255,255,255,0.05);border:1.5px solid rgba(255,255,255,0.09);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column;gap:18px;transition:background 0.2s}
.tcard:hover{background:rgba(255,255,255,0.08)}
.tcard-quote{font-size:15px;line-height:1.8;color:rgba(255,255,255,0.75);font-weight:400;flex:1}
.tcard-quote::before{content:'"';font-family:var(--serif);font-size:44px;color:var(--green-light);line-height:0.8;display:block;margin-bottom:10px}
.tcard-author{border-top:1px solid rgba(255,255,255,0.08);padding-top:18px}
.tcard-name{font-weight:800;font-size:14px;color:#fff}
.tcard-role{font-size:13px;color:rgba(255,255,255,0.4);margin-top:2px;font-weight:600}
.tcard-company{display:inline-block;margin-top:8px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--green-light);background:rgba(125,217,154,0.12);padding:4px 10px;border-radius:50px;font-weight:700}

/* PRICING */
.pricing{background:var(--green-xpale);padding:96px 56px}
.pricing-inner{max-width:1100px;margin:0 auto}
.pricing-header{margin-bottom:52px;display:flex;justify-content:space-between;align-items:flex-end;gap:40px}
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start}
.price-card{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:36px 32px;position:relative;transition:transform 0.2s,box-shadow 0.2s}
.price-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(46,139,74,0.12)}
.price-card.popular{border-color:var(--green);border-width:2.5px}
.popular-badge{position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:var(--terra);color:#fff;font-size:11px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;padding:5px 16px;border-radius:50px;white-space:nowrap;box-shadow:0 4px 12px rgba(212,97,60,0.35)}
.price-tier{font-size:12px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:var(--green);margin-bottom:8px}
.price-events{font-family:var(--serif);font-size:30px;font-weight:600;color:var(--charcoal);line-height:1.1;margin-bottom:4px}
.price-events span{font-size:15px;font-weight:400;color:var(--muted);font-family:var(--sans)}
.price-sub{font-size:14px;color:var(--muted);margin-bottom:24px;font-weight:600}
.price-divider{height:1.5px;background:var(--border);margin-bottom:22px}
.price-features{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:28px}
.price-features li{font-size:16px;color:var(--mid);display:flex;align-items:flex-start;gap:10px;line-height:1.5;font-weight:600}
.price-features li::before{content:'✓';color:var(--green);font-weight:800;font-size:13px;min-width:16px}
.price-features li.extra{color:var(--green-dark)}
.price-cta{display:block;text-align:center;padding:14px;border-radius:50px;font-size:14px;font-weight:800;text-decoration:none;border:1.5px solid var(--border);color:var(--mid);transition:all 0.2s;font-family:var(--sans)}
.price-cta:hover{border-color:var(--green);color:var(--green)}
.price-card.popular .price-cta{background:var(--green);color:#fff;border-color:var(--green)}
.price-card.popular .price-cta:hover{background:var(--green-mid)}
.pricing-footnote{text-align:center;font-size:13px;color:var(--muted);margin-top:28px;font-weight:600}

/* CONTACT */
.contact-section{background:var(--cream);padding:96px 56px}
.contact-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.contact-cards{display:flex;flex-direction:column;gap:16px;margin-top:36px}
.contact-card{background:var(--warm);border:1.5px solid var(--border);border-radius:var(--radius);padding:28px 32px;display:flex;align-items:center;gap:20px;text-decoration:none;transition:transform 0.2s,box-shadow 0.2s,border-color 0.2s;color:inherit}
.contact-card:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(212,97,60,0.12);border-color:var(--terra)}
.contact-card-icon{width:52px;height:52px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0}
.contact-card-icon.email-icon{background:#E8F4FD}
.contact-card-icon.cal-icon{background:var(--yellow-pale)}
.contact-card-body{flex:1}
.contact-card-label{font-size:11px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.contact-card-title{font-size:17px;font-weight:800;color:var(--charcoal)}
.contact-card-sub{font-size:13px;color:var(--muted);font-weight:600;margin-top:2px}
.contact-card-arrow{font-size:20px;color:var(--terra);transition:transform 0.2s}
.contact-card:hover .contact-card-arrow{transform:translateX(4px)}
.contact-form-card{background:var(--warm);border:1.5px solid var(--border);border-radius:20px;padding:40px}
.form-title{font-family:var(--serif);font-size:22px;font-weight:600;color:var(--charcoal);margin-bottom:24px}
.form-group{margin-bottom:18px}
.form-label{font-size:13px;font-weight:700;color:var(--mid);display:block;margin-bottom:6px}
.form-input{width:100%;padding:12px 16px;border-radius:var(--radius-sm);border:1.5px solid var(--border);background:var(--cream);font-family:var(--sans);font-size:15px;color:var(--charcoal);transition:border-color 0.2s;outline:none}
.form-input:focus{border-color:var(--green)}
.form-input::placeholder{color:var(--muted)}
textarea.form-input{height:120px;resize:vertical}
.form-submit{width:100%;padding:15px;border-radius:50px;background:var(--terra);color:#fff;border:none;font-family:var(--sans);font-size:15px;font-weight:800;cursor:pointer;transition:background 0.2s,transform 0.15s}
.form-submit:hover{background:#c25530;transform:translateY(-2px)}

/* CTA BAND */
.cta-band{background:var(--terra);padding:80px 56px;text-align:center;position:relative;overflow:hidden}
.cta-band .section-title{color:#fff;margin-bottom:16px}
.cta-band .section-title em{color:var(--yellow-pale)}
.cta-band .section-body{color:rgba(255,255,255,0.75);margin:0 auto 36px}
.cta-band .section-label{background:rgba(255,255,255,0.18);color:rgba(255,255,255,0.95)}
.btn-yellow{display:inline-flex;align-items:center;gap:8px;background:var(--yellow);color:var(--charcoal);padding:16px 36px;border-radius:50px;font-weight:800;font-size:15px;text-decoration:none;transition:background 0.2s,transform 0.15s;box-shadow:0 4px 20px rgba(245,200,66,0.4)}
.btn-yellow:hover{background:#f7d44a;transform:translateY(-2px)}

/* FOOTER */
footer{background:var(--charcoal);padding:48px 56px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px}
.footer-logo img{height:32px;width:auto;filter:brightness(0) invert(1);opacity:0.8}
.footer-links{display:flex;gap:28px;list-style:none}
.footer-links a{font-size:13px;color:rgba(255,255,255,0.35);text-decoration:none;font-weight:700;transition:color 0.2s}
.footer-links a:hover{color:rgba(255,255,255,0.8)}
.footer-copy{font-size:12px;color:rgba(255,255,255,0.25);font-weight:600}
.footer-social{display:flex;gap:12px}
.footer-social a{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;font-size:15px;text-decoration:none;transition:background 0.2s}
.footer-social a:hover{background:rgba(255,255,255,0.18)}

/* RESPONSIVE */
@media(max-width:960px){
  nav{padding:0 24px}
  .nav-links{display:none}
  .hero{grid-template-columns:1fr;padding:120px 24px 60px;gap:40px;min-height:auto}
  .hero-photo-card img{height:360px}
  section{padding:72px 24px}
  .services-inner{grid-template-columns:1fr;gap:48px}
  .services-left{position:static}
  .steps-grid{grid-template-columns:1fr 1fr}
  .reach-inner{grid-template-columns:1fr}
  .testimonials-grid{grid-template-columns:1fr}
  .pricing-grid{grid-template-columns:1fr}
  .pricing-header{flex-direction:column}
  .how-header{flex-direction:column}
  .contact-inner{grid-template-columns:1fr}
  .gallery-section{padding:72px 0 0}
  .gallery-inner{padding:0 0 32px}
  .gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:auto}
  .gallery-item{aspect-ratio:4/3!important;grid-column:auto!important;grid-row:auto!important}
  .retailers-band{gap:24px;padding:24px}
  footer{padding:32px 24px;flex-direction:column;text-align:center}
  .footer-links{flex-wrap:wrap;justify-content:center}
}
@media(max-width:600px){
  .hero h1{font-size:36px}
  .steps-grid{grid-template-columns:1fr}
  .states-grid{grid-template-columns:repeat(4,1fr)}
  .gallery-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<nav>
  <a class="nav-logo" href="#"><img src="data:image/png;base64," alt="Grassroots Marketing"></a>
  <ul class="nav-links">
    <li><a href="#services">Services</a></li>
    <li><a href="#reach">Reach</a></li>
    <li><a href="#testimonials">Reviews</a></li>
    <li><a href="#pricing">Pricing</a></li>
    <li><a href="#contact" class="nav-cta">Let's Talk 👋</a></li>
  </ul>
</nav>

<section class="hero">
  <div class="hero-left">
    <h1>Where great <em>products</em> meet real people.</h1>
    <p class="hero-desc">Grassroots runs high-performance in-store demos and brand ambassador programs across 17 states — putting your product directly into the hands of shoppers at Whole Foods, Sprouts, and Erewhon.</p>
    <div class="hero-actions">
      <a href="https://calendly.com/grassrootsmarketing/introductory-call" target="_blank" class="btn-primary">📅 Book an Intro Call</a>
      <a href="#services" class="btn-secondary">See how it works</a>
    </div>
    <div class="hero-stats">
      <div><div class="stat-num">36K+</div><div class="stat-label">Demo events run</div></div>
      <div><div class="stat-num">17</div><div class="stat-label">States nationwide</div></div>
      <div><div class="stat-num">10 yrs</div><div class="stat-label">In the field</div></div>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hero-photo-card">
      <img src="data:image/jpeg;base64," alt="In-store demo setup at Sprouts">
    </div>
  </div>
</section>

<div class="retailers-band">
  <div class="retailers-band-label">Retail partners</div>
  <div class="retailer-pill">Whole Foods Market</div>
  <div class="retailer-pill">Sprouts Farmers Market</div>
  <div class="retailer-pill">Erewhon</div>
  <div class="retailer-pill">Central Market</div>
</div>

<div class="logo-strip">
  <div class="logo-strip-label">Brands we've represented</div>
  <div class="logo-track"><div class="logo-inner">
    <div class="logo-item"><img src="data:image/png;base64," alt="Mary Ruth's"></div>
    <div class="logo-item"><img src="data:image/png;base64," alt="Tractor Beverage"></div>
    <div class="logo-item"><img src="data:image/png;base64," alt="Harken"></div>
    <div class="logo-item"><img src="data:image/png;base64," alt="Bachan's"></div>
    <div class="logo-item"><img src="data:image/png;base64," alt="Cravings"></div>
